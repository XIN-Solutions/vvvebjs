{
  "name": "vvvebjs",
  "description": "Drag and drop website builder javascript library",
  "version": "0.0.1",
  "author": "Ziadin Givan",
  "license": "Apache-2.0",
  "homepage": "https://www.vvveb.com/vvvebjs/editor.html",
  "main": "libs/builder/builder.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/givanz/VvvebJs.git"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "keywords": [
    "vvvebjs",
    "drag-drop",
    "drag&drop",
    "drag",
    "drop",
    "wysiwyg",
    "web",
    "template",
    "editor",
    "site",
    "builder"
  ],
  "scripts": {
    "gulp": "gulp",
    "theme_proxy": "node proxy.js",
    "remote_theme_proxy": "node proxy.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "vendor:easymde": "mkdir -p libs/easymde libs/font-awesome/css libs/font-awesome/webfonts && cp node_modules/easymde/dist/easymde.min.js node_modules/easymde/dist/easymde.min.css libs/easymde/ && cp node_modules/@fortawesome/fontawesome-free/css/all.min.css libs/font-awesome/css/ && cp node_modules/@fortawesome/fontawesome-free/webfonts/* libs/font-awesome/webfonts/",
    "build": "TAG=$(date +%Y%m%d_%H%M) && docker build -f Dockerfile -t dr.xinsolutions.co.nz/exoh/exoh-editor:$TAG -t dr.xinsolutions.co.nz/exoh/exoh-editor:latest . && echo \"Built dr.xinsolutions.co.nz/exoh/exoh-editor:$TAG\""
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "easymde": "^2.21.0",
    "gulp": "^4.0.2",
    "gulp-file-include": "^2.3.0",
    "gulp-format-html": "^1.2.5",
    "gulp-sass": "^5.1.0",
    "sass": "^1.83.4",
    "through2": "^4.0.2"
  }
}
